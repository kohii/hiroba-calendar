---
import '../styles/global.css';

const title = 'ひろばカレンダー｜さいたま市 子育て支援センターの予定';
const description = 'さいたま市の子育て支援センターのひろばとイベントの予定を、日付や施設ごとに確認できます';

// Get current year in Asia/Tokyo timezone for copyright
const year = new Date().toLocaleString('en-US', { timeZone: 'Asia/Tokyo', year: 'numeric' });
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="description" content={description}>
  <meta name="theme-color" content="#fbf8f3" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1c1a17" media="(prefers-color-scheme: dark)">
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>
  <header class="appbar">
    <div class="appbar-inner">
      <p class="brand">ひろばカレンダー</p>
      <div id="scope" class="scope" hidden></div>
      <button id="edit-centers" type="button" class="appbar-button" aria-label="マイ施設を選ぶ">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.25 4.1 1 5.8L12 16.9l-5.25 2.7 1-5.8L3.5 9.7l5.9-.9z"/></svg>
      </button>
    </div>
  </header>

  <main id="main" class="main" aria-live="polite">
    <p class="loading">読み込み中…</p>
  </main>

  <footer class="footer">
    <p>各子育て支援センターが公開している予定表PDFから作成した非公式のサイトです。最新の情報は各施設の予定表でご確認ください。</p>
    <div class="footer-links">
      <span class="footer-copyright">© {year} kohii</span>
      <a href="https://github.com/kohii/hiroba-calendar" target="_blank" rel="noopener noreferrer" title="ひろばカレンダー on GitHub" class="footer-github">
        <svg class="footer-github-icon" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        GitHub
      </a>
    </div>
  </footer>

  <nav class="tabbar" aria-label="表示の切り替え">
    <a class="tab" data-view="schedule" href="./">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/></svg>
      予定
    </a>
    <a class="tab" data-view="center" href="?view=center">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11l8-6 8 6M6 10v9h12v-9M10 19v-5h4v5"/></svg>
      施設
    </a>
  </nav>

  <dialog id="centers-dialog" class="sheet" aria-labelledby="centers-dialog-title">
    <form method="dialog" class="sheet-inner">
      <div class="sheet-head">
        <h2 id="centers-dialog-title">マイ施設</h2>
        <button class="primary-button" value="done">完了</button>
      </div>
      <p class="sheet-lead">よく行く施設を選ぶと、予定の画面にはその施設だけが表示されます</p>
      <ul class="dialog-list"></ul>
    </form>
  </dialog>

  <dialog id="day-dialog" class="sheet" aria-label="この日の予定">
    <form method="dialog" class="sheet-inner"></form>
  </dialog>

  <script src="../scripts/app.ts"></script>
</body>
</html>
