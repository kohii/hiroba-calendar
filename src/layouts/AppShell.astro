---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  currentPage?: 'schedule' | 'center' | 'about';
}

const { title, description, currentPage } = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="description" content={description}>
  <meta name="theme-color" content="#fbf8f3" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1c1a17" media="(prefers-color-scheme: dark)">
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>
  <header class="appbar">
    <div class="appbar-inner">
      <a class="brand" href="./">ひろばカレンダー</a>
      <a class="appbar-button" href="about" aria-label="このサイトについて" aria-current={currentPage === 'about' ? 'page' : undefined}>
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 11v5M12 8h.01"/></svg>
      </a>
    </div>
  </header>

  <slot />

  <nav class="tabbar" aria-label="表示の切り替え">
    <a class="tab" data-view="schedule" href="./" aria-current={currentPage === 'schedule' ? 'page' : undefined}>
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/></svg>
      予定
    </a>
    <a class="tab" data-view="center" href="?view=center" aria-current={currentPage === 'center' ? 'page' : undefined}>
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11l8-6 8 6M6 10v9h12v-9M10 19v-5h4v5"/></svg>
      施設
    </a>
  </nav>
</body>
</html>
