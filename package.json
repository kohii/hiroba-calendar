{
  "name": "hiroba-calendar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "astro dev --port 43123",
    "build": "astro build",
    "preview": "astro preview --port 43123",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src",
    "test": "node --test --experimental-strip-types tests/**/*.test.ts",
    "discover-pdfs": "node --experimental-strip-types scripts/pdf-discovery.ts",
    "download-pdfs": "node --experimental-strip-types scripts/pdf-download.ts",
    "refresh-data": "node --experimental-strip-types scripts/refresh-all.ts",
    "dataset-stats": "node --experimental-strip-types scripts/merge-dataset.ts stats",
    "cleanup": "node --experimental-strip-types scripts/merge-dataset.ts cleanup",
    "verify-pdfs": "node --experimental-strip-types scripts/verify-pdf-urls.ts"
  },
  "dependencies": {
    "astro": "5.18.2",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  }
}
